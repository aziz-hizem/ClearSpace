{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClearSpace",
  "mainBinaryName": "ClearSpace",
  "version": "0.1.0",
  "identifier": "io.github.aziz-hizem.clearspace",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ClearSpace",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 620,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "devCsp": null,
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "ClearSpace contributors",
    "copyright": "© ClearSpace contributors",
    "category": "Utility",
    "shortDescription": "See what fills your disk and what is safe to clean.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
